{
  "expo": {
    "name": "Ukelele Barítono",
    "slug": "ukelele-baritono",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "scheme": "ukelelebaritono",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#0f766e",
    "backgroundColor": "#fafaf9",
    "ios": {
      "bundleIdentifier": "com.ifguido.ukelelebaritono",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon/icon.png",
        "dark": "./assets/icon/icon-dark.png",
        "tinted": "./assets/icon/icon-tinted.png"
      },
      "infoPlist": {
        "CFBundleDisplayName": "Ukelele Barítono",
        "CFBundleLocalizations": [
          "es"
        ],
        "CFBundleDevelopmentRegion": "es",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      },
      "appleTeamId": "77C9TD2YD6"
    },
    "android": {
      "package": "com.ifguido.ukelelebaritono",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "backgroundImage": "./assets/icon/adaptive-background.png",
        "monochromeImage": "./assets/icon/adaptive-monochrome.png",
        "backgroundColor": "#0f766e"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f766e",
          "image": "./assets/icon/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0c0a09",
            "image": "./assets/icon/splash-icon.png"
          }
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "iosMicrophonePermission": "El afinador escucha el ukelele para decirte si cada cuerda está afinada. El audio se analiza en el teléfono y no se guarda ni se envía a ningún lado.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO"
          ],
          "androidForegroundService": false,
          "androidFSTypes": [],
          "disableFFmpeg": true
        }
      ],
      [
        "./plugins/withShareExtensionName",
        {
          "displayName": "Ukelele Barítono"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          },
          "iosAppGroupIdentifier": "group.com.ifguido.ukelelebaritono",
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "684111b7-0b22-463c-a3fd-8e3217bc485e"
      },
      "router": {}
    },
    "owner": "ifguido"
  }
}
